# 1. Chave de API da Groq para transcrição de áudio ultrarrápida (Whisper Large v3):
# Obtenha gratuitamente em: https://console.groq.com/keys
GROQ_API_KEY=sua_chave_groq_aqui

# 2. Token da Hugging Face para geração de imagens (FLUX.1-dev e FLUX.1-schnell):
# Obtenha em: https://huggingface.co/settings/tokens
HF_TOKEN=seu_token_hugging_face_aqui

# 3. (Opcional) Chave de API do Google AI Studio:
GEMINI_API_KEY=sua_chave_gemini_aqui

PORT=3000
